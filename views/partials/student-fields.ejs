<label>Identifiant <small>(initiale du nom, un point, puis le prénom, jamais le nom de famille&nbsp;: m.alice)</small>
  <input name="login" required maxlength="40" pattern="[a-z0-9]+(\.[a-z0-9]+)?" placeholder="m.alice" autocapitalize="none" spellcheck="false"
    value="<%= values.login ?? '' %>" <%- errors.login ? 'aria-invalid="true"' : '' %>>
  <% if (errors.login) { %><small data-testid="error-login"><%= errors.login %></small><% } %>
</label>
<fieldset class="checklist" data-testid="student-groups">
  <legend>Classes <small>(aucune, une ou plusieurs)</small></legend>
  <% if (groups.length === 0) { %><p><small>Aucune classe pour le moment.</small></p><% } %>
  <% const chosen = [].concat(values.groupIds ?? []); %>
  <% groups.forEach((g) => { %>
    <label><input type="checkbox" name="groupIds" value="<%= g.id %>" <%- chosen.includes(g.id) ? 'checked' : '' %>> <%= g.name %></label>
  <% }) %>
</fieldset>

  <ol>
    <li><a href="#demarrer">Démarrer avec une classe</a></li>
    <li><a href="#classes">Classes</a></li>
    <li><a href="#eleves">Élèves et QR codes</a></li>
    <li><a href="#exercices">Exercices</a></li>

<%- include('../partials/head') %>
<h1>Importer des élèves</h1>
<p>Le fichier est l’export CSV du logiciel de vie scolaire&nbsp;: une ligne d’en-tête, puis une ligne par élève. Seules les colonnes <strong>Élèves</strong> et <strong>Né(e) le</strong> (JJ/MM/AAAA) sont lues. Si un nom correspond à un élève déjà enregistré, vous choisirez avant l’import de réutiliser cet élève (il est ajouté à la classe) ou d’en créer un nouveau.</p>
<% if (error) { %><p class="flash flash-error" role="alert" data-testid="form-error"><%= error %></p><% } %>
<% if (result) { %>
  <article data-testid="import-result">
    <p class="flash flash-success">
      <strong data-testid="created-count"><%= result.created.length %></strong> élève<%= result.created.length > 1 ? 's' : '' %> créé<%= result.created.length > 1 ? 's' : '' %>,
      <strong data-testid="added-count"><%= result.added.length %></strong> existant<%= result.added.length > 1 ? 's' : '' %> ajouté<%= result.added.length > 1 ? 's' : '' %>
      à <%= result.groupName %>.
    </p>
    <% if (result.created.length > 0) { %>
      <details open><summary>Créés</summary><ul><% result.created.forEach((s) => { %><li><a href="/admin/students/<%= s.id %>"><%= s.name %></a></li><% }) %></ul></details>
    <% } %>
    <% if (result.added.length > 0) { %>
      <details open><summary>Élèves existants ajoutés à la classe</summary><ul><% result.added.forEach((s) => { %><li>Ligne <%= s.line %>&nbsp;: <a href="/admin/students/<%= s.id %>"><%= s.name %></a></li><% }) %></ul></details>
    <% } %>
    <% if (result.already.length > 0) { %>
      <details><summary><span data-testid="already-count"><%= result.already.length %></span> déjà dans la classe</summary><ul><% result.already.forEach((s) => { %><li>Ligne <%= s.line %>&nbsp;: <a href="/admin/students/<%= s.id %>"><%= s.name %></a></li><% }) %></ul></details>
    <% } %>
    <% if (result.skipped.length > 0) { %>
      <details><summary><span data-testid="skipped-count"><%= result.skipped.length %></span> ignoré<%= result.skipped.length > 1 ? 's' : '' %></summary>
        <ul><% result.skipped.forEach((s) => { %><li>Ligne <%= s.line %>&nbsp;: <%= s.name %> — <%= s.reason %></li><% }) %></ul></details>
    <% } %>
    <% if (result.errors.length > 0) { %>
      <details open><summary><span data-testid="error-count"><%= result.errors.length %></span> ligne<%= result.errors.length > 1 ? 's' : '' %> rejetée<%= result.errors.length > 1 ? 's' : '' %></summary>
        <ul><% result.errors.forEach((e) => { %><li>Ligne <%= e.line %>&nbsp;: <%= e.message %></li><% }) %></ul></details>
    <% } %>
    <a href="/admin/groups/<%= result.groupId %>" role="button">Voir la classe</a>
  </article>
<% } %>
<% if (groups.length === 0) { %>
  <p>Créez d’abord une <a href="/admin/groups">classe</a>.</p>
<% } else { %>
<form method="post" action="/admin/students/import" enctype="multipart/form-data" data-testid="import-form">
  <label>Classe
    <select name="groupId" required>
      <option value="">Choisir…</option>
      <% groups.forEach((g) => { %><option value="<%= g.id %>" <%- groupId === g.id ? 'selected' : '' %>><%= g.name %></option><% }) %>
    </select>
  </label>
  <label>Fichier CSV (2&nbsp;Mo au plus)
    <input type="file" name="file" accept=".csv,text/csv" required>
  </label>
  <button type="submit">Importer</button>
</form>
<% } %>
<%- include('../partials/foot') %>

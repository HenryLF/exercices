# Local: `docker compose up -d` starts MongoDB on this URI.
MONGODB_URI=mongodb://127.0.0.1:27017/exercices
# At least 32 characters each. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me
# Signs QR login tokens. Changing it invalidates every printed QR code.
QR_SECRET=change-me-too-change-me-too-change-me-too
# Public origin, used inside the QR codes. No trailing slash.
BASE_URL=http://localhost:3000
PORT=3000
